# Copy this file to .env and fill in your values.
# .env is git-ignored — NEVER commit real secrets.
# Keys MUST be UPPERCASE exactly as shown below.

# --- Groq (default provider — fast, generous free tier) ---
GROQ_API_KEY=

# --- Gemini ---
# Switch provider in config.yaml: llm_provider: "gemini"
GEMINI_API_KEY=

# --- Ollama (local, no key needed) ---
# Switch provider in config.yaml: llm_provider: "ollama"
